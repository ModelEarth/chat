{
  "name": "chat-nextjs",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }

  // Not needed for Neon: chat's Neon HTTP driver (lib/db/queries/base.ts)
  // reaches Neon over HTTPS from a Worker as-is.
  //
  // For Supabase (dual support, later): the Neon HTTP driver can't reach
  // Supabase, so chat will need a TCP driver (Postgres.js, already a
  // dependency, or "pg") through Hyperdrive, Cloudflare's connection pooler
  // for Workers. Create it once with Supabase's direct connection string
  // (not the pooler URL; Hyperdrive does the pooling):
  //   npx wrangler hyperdrive create chat-db --connection-string="<Supabase direct connection string>"
  // then uncomment this with the id it prints, and connect with
  // env.HYPERDRIVE.connectionString:
  // "hyperdrive": [
  //   { "binding": "HYPERDRIVE", "id": "<hyperdrive-id-from-wrangler-create>" }
  // ]

  // Optional — only needed if/when you use ISR or Next's data cache:
  // "kv_namespaces": [
  //   { "binding": "NEXT_CACHE_WORKERS_KV", "id": "<your-kv-namespace-id>" }
  // ]
}
